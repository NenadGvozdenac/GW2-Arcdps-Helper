# Template for .env.production (copy it and fill in real values). .env.production is git-ignored and never
# uploaded to Vercel — on Vercel set the same variables in Project Settings → Environment Variables.
# Used locally by `npm run migrate:production` / `make migrate-prod` to migrate the production database.
NODE_ENV=production

# Neon / Vercel Postgres / Supabase connection string (with ?sslmode=require)
DATABASE_URL=postgres://USER:PASSWORD@HOST/DATABASE?sslmode=require

# At least 32 random characters: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# The deployed frontend URL(s), comma-separated
CORS_ORIGIN=https://gw2-arcdps-helper.vercel.app

# The deployed frontend URL — used for the link in the confirmation email
APP_URL=https://gw2-arcdps-helper.vercel.app

# SMTP server for confirmation and password-reset emails. Gmail: smtp.gmail.com, port 465, your address + an app password
# (Google account → Security → App passwords). Resend / Brevo / Mailgun give you SMTP credentials too.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# The administrator (/admin): `make admin-prod` prints these three lines - put them here and in Vercel.
# Empty = the admin area is off.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_TOTP_SECRET=
