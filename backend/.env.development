# Local development: `npm run dev`, `npm run migrate`, and the Docker stack (docker-compose.yml overrides
# DATABASE_URL so the container reaches the `db` service). Dev-only values — safe to commit.
NODE_ENV=development

# Postgres from `make db-up` / `make up`
DATABASE_URL=postgres://gw2:gw2@localhost:5432/gw2arcdpshelper

# Dev-only secret. Never reuse it in production.
JWT_SECRET=d8ln5ndV3BRm9uaOp7WRZxZu4F3v9wNOIh7IGZwG5YRE+ILxflIKOxq0E4tV2jDj

# Vite dev server and the Docker nginx frontend
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

PORT=3000

# Frontend URL for the links in confirmation / password-reset emails (Vite dev server)
APP_URL=http://localhost:5173

# SMTP for confirmation / password-reset emails. Left empty: emails are printed to the backend console instead of
# sent, so you can open the link from there. To really send them, fill these in locally but don't commit the
# password — this file is in git. Gmail: smtp.gmail.com, port 465, your address + an app password.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# The administrator (/admin): `make admin-dev` fills these in (dev-only - never use a real password here).
# Empty = the admin area is off.
ADMIN_EMAIL=gw2arcdpshelper@gmail.com
ADMIN_PASSWORD_HASH=scrypt:398eae57861d1d4142ff7a8220711106:dca5736f8ab82a0e73a49c6974850a7cd8ac104d04bfa94eb193f0bacb3426e69dc603953dfdb4f080ff3057a7ff2e3fad48380e28fbe8f1da1e7351775f0e7e
ADMIN_TOTP_SECRET=EP4O7C2KXLIKEQJTNT2VRP4QMR2D637Q
