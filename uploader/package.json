{
  "name": "gw2-arcdps-helper-uploader",
  "productName": "GW2 ArcDPS Helper Uploader",
  "version": "0.1.0",
  "description": "Watches the ArcDPS log folder, uploads new logs to dps.report and saves them to GW2 ArcDPS Helper.",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev --mode development",
    "dev:prod": "electron-vite dev --mode production",
    "build": "npm run typecheck && electron-vite build --mode production",
    "preview": "electron-vite preview --mode production",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --win --dir"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.48.0",
    "radix-ui": "^1.6.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0"
  }
}
